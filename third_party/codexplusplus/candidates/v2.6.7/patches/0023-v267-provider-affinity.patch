+    #[test]
+    fn desktop_title_has_no_owner_in_dual_provider_mode() {
+        let mut settings = BackendSettings::default();
+        settings.relay_profiles = [
+            ANTICODEX_ANTIGRAVITY_RELAY_ID,
+            ANTICODEX_THIRD_PARTY_RELAY_ID,
+        ]
+        .map(|id| RelayProfile {
+            id: id.to_owned(),
+            ..Default::default()
+        })
+        .to_vec();
+        let title = json!({"thread_source":"thread_title","turn_trigger":"thread_title"});
+        let body = json!({"client_metadata": {CODEX_TURN_METADATA_KEY: title.to_string()}});
+        assert!(is_unbound_desktop_title(&settings, &body, None));
+        assert!(is_unbound_desktop_title(
+            &settings,
+            &Value::Null,
+            Some(&title.to_string())
+        ));
+        let ordinary = json!({"input":"thread_title","client_metadata":{CODEX_TURN_METADATA_KEY:{"thread_source":"user","turn_trigger":"composer"}}});
+        assert!(!is_unbound_desktop_title(&settings, &ordinary, None));
+        settings.relay_profiles.pop();
+        assert!(!is_unbound_desktop_title(&settings, &body, None));
+    }
