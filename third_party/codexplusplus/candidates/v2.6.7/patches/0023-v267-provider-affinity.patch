+pub(crate) fn is_unbound_desktop_title(
+    settings: &BackendSettings,
+    request: &Value,
+    turn_metadata: Option<&str>,
+) -> bool {
+    let profiles = &settings.relay_profiles;
+    if !profiles
+        .iter()
+        .any(|p| p.id == ANTICODEX_THIRD_PARTY_RELAY_ID)
+        || !profiles
+            .iter()
+            .any(|p| p.id == ANTICODEX_ANTIGRAVITY_RELAY_ID)
+    {
+        return false;
+    }
+    codex_turn_metadata_value(request, turn_metadata).is_some_and(|meta| {
+        meta.get("thread_source").and_then(Value::as_str) == Some("thread_title")
+            || meta.get("turn_trigger").and_then(Value::as_str) == Some("thread_title")
+    })
+}
