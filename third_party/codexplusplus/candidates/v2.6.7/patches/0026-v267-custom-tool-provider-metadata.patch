+#[test]
+fn streamed_gemini_custom_tool_signature_survives_history_replay() {
+    let extra_content = json!({"google":{"thought_signature":"GEMINI-CUSTOM-SIGNATURE"}});
+    let stream = format!(
+        "data: {}\n\ndata: [DONE]\n\n",
+        json!({
+            "id": "chatcmpl_gemini_custom", "model": "gemini-3.1-flash-lite",
+            "choices": [{
+                "delta": {"tool_calls": [{
+                    "index": 0, "id": "call_gemini_custom", "type": "function",
+                    "function": {"name": "apply_patch", "arguments": "{\"input\":\"fixture patch\"}"},
+                    "extra_content": extra_content
+                }]},
+                "finish_reason": "tool_calls"
+            }]
+        }),
+    );
+    let converted = chat_sse_to_responses_sse_with_request(
+        &stream,
+        &json!({"model":"gemini-3.1-flash-lite","tools":[{"type":"custom","name":"apply_patch"}]}),
+    );
+    let call = converted
+        .lines()
+        .filter_map(|line| serde_json::from_str::<Value>(line.strip_prefix("data: ")?).ok())
+        .find(|event| event["type"] == "response.output_item.done")
+        .expect("stream returned the custom call")["item"]
+        .clone();
+    assert_eq!(call["type"], "custom_tool_call");
+
+    let replayed = responses_to_chat_completions(json!({
+        "model":"gemini-3.1-flash-lite",
+        "input":[
+            call,
+            {"type":"custom_tool_call_output","call_id":"call_gemini_custom","output":"fixture result"},
+            {"type":"custom_tool_call","call_id":"call_unsigned_custom","name":"apply_patch","input":"another patch"},
+            {"type":"custom_tool_call_output","call_id":"call_unsigned_custom","output":"another result"}
+        ]
+    })).unwrap();
+    let messages = replayed["messages"].as_array().unwrap();
+    let tool_calls: Vec<_> = messages
+        .iter()
+        .filter_map(|message| message["tool_calls"].get(0))
+        .collect();
+    assert_eq!(tool_calls[0]["extra_content"], extra_content);
+    assert_eq!(
+        tool_calls[0]["function"]["arguments"],
+        "{\"input\":\"fixture patch\"}"
+    );
+    assert!(tool_calls[1].get("extra_content").is_none());
+    assert_eq!(messages[1]["tool_call_id"], "call_gemini_custom");
+    assert_eq!(messages[1]["content"], "fixture result");
+}
